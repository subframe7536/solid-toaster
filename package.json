{
  "name": "solid-toaster",
  "version": "0.1.5",
  "description": "An advanced sonner-like toast component for solid.js",
  "homepage": "https://github.com/subframe7536/solid-toaster#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/solid-toaster/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/solid-toaster.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js",
      "type": "./dist/index.d.ts"
    },
    "./compact": {
      "solid": "./dist/compact.jsx",
      "default": "./dist/compact.js",
      "type": "./dist/compact.d.ts"
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/styles.css",
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css",
    "./theme.css": "./dist/theme.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite serve playground",
    "test": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "qa": "oxfmt && oxlint --fix --deny-warnings && tsc --noEmit",
    "release": "bun run test --run && bumpp --all",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.121",
    "@solidjs/testing-library": "^0.8.10",
    "@subf/config": "^0.2.1",
    "@subf/unocss": "^0.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.10.7",
    "bumpp": "^11.1.0",
    "cls-variant": "^1.2.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "solid-js": "^1.9.11"
  }
}
